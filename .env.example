# ═══════════════════════════════════════════════════════════════
#  MMA IQ — Modèle de variables d'environnement
#  Copie ce fichier en `.env` et remplis les valeurs.
#  `.env` est ignoré par git ; ce `.env.example` est versionné.
# ═══════════════════════════════════════════════════════════════

# ── Supabase (backend) ────────────────────────────────────────
VITE_SUPABASE_URL=https://tmmtabzxcgxlmsgfgxwx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Clé service role (serveur UNIQUEMENT, jamais côté navigateur) — enregistrement des achats et URLs vidéo signées.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ─────────────────────────────────────────────────────
# Email qui obtient le rôle super_admin dans l'app.
VITE_ADMIN_EMAIL=
# (Actuellement non lu par le code — le code d'accès du mode
#  édition CMS est géré côté client. Conservé pour référence.)
VITE_ADMIN_PASSWORD=

# ── Stripe (paiements) ────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=   # pk_test_... ou pk_live_... (navigateur)
STRIPE_SECRET_KEY=             # sk_test_... ou sk_live_... (serveur)
# Secret de signature du webhook Stripe (whsec_...) — requis pour /api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=
# Catalogue de lancement (mois 1 à 6) issu du simulateur commercial V1.
# Montants en centimes, lus uniquement par scripts/stripe-bootstrap.mjs.
STRIPE_PRICE_ESSENTIEL_MONTHLY_CENTS=699
STRIPE_PRICE_ESSENTIEL_YEARLY_CENTS=6999
STRIPE_PRICE_PERFORMANCE_MONTHLY_CENTS=1099
STRIPE_PRICE_PERFORMANCE_YEARLY_CENTS=10999
STRIPE_PRICE_ELITE_MONTHLY_CENTS=2099
STRIPE_PRICE_ELITE_YEARLY_CENTS=20999
STRIPE_PRICE_COACH_SUITE_MONTHLY_CENTS=2099
STRIPE_PRICE_COACH_SUITE_YEARLY_CENTS=20999

# ── Compte MMA IQ (abonnements) ──────────────────────────────
# Client Keycloak PUBLIC, Authorization Code + PKCE S256.
VITE_MMAIQ_OIDC_URL=https://auth.mmaiq.fr
VITE_MMAIQ_OIDC_REALM=MMA
VITE_MMAIQ_OIDC_CLIENT_ID=mmaiq-web
# Backend qui valide le JWT et renvoie l'identité bénéficiaire au serveur du site.
LAB_SERVICE_URL=https://api.mmaiq.fr/lab-service
# Ouvre les boutons de paiement après configuration Stripe + Keycloak + webhook.
VITE_ENABLE_CHECKOUT=false

# ── Serveur ───────────────────────────────────────────────────
APP_URL=http://localhost:3000
